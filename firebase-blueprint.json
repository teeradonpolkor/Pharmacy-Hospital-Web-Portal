{
  "entities": {
    "AppItem": {
      "title": "AppItem",
      "description": "Application link item in the portal",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the app",
          "maxLength": 128
        },
        "categoryId": {
          "type": "string",
          "description": "Category ID this app belongs to",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Name of the application",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "description": "Description of the application",
          "maxLength": 1000
        },
        "url": {
          "type": "string",
          "description": "Target Web URL or Google Apps Script URL",
          "maxLength": 1000
        },
        "iconName": {
          "type": "string",
          "description": "Lucide icon identifier",
          "maxLength": 64
        },
        "tag": {
          "type": "string",
          "description": "Sub-tag or badge label",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "enum": ["online", "maintenance", "updated"],
          "description": "Operational status"
        },
        "isFavorite": {
          "type": "boolean",
          "description": "Whether pinned to favorites"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "categoryId", "title", "url", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Portal category grouping",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Category identifier",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Category display name",
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "description": "Category description",
          "maxLength": 500
        },
        "iconName": {
          "type": "string",
          "description": "Icon identifier",
          "maxLength": 64
        },
        "accentColor": {
          "type": "string",
          "description": "Hex accent color",
          "maxLength": 30
        }
      },
      "required": ["id", "name"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Hospital bulletin or urgent memo",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Announcement identifier",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Bulletin title",
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "description": "Bulletin message body",
          "maxLength": 2000
        },
        "date": {
          "type": "string",
          "description": "Date label string",
          "maxLength": 50
        },
        "type": {
          "type": "string",
          "enum": ["urgent", "info", "update"],
          "description": "Announcement type"
        },
        "isPinned": {
          "type": "boolean",
          "description": "Pinned status"
        }
      },
      "required": ["id", "title", "content", "type"]
    },
    "PortalSettings": {
      "title": "PortalSettings",
      "description": "Global hospital portal configuration",
      "type": "object",
      "properties": {
        "pin": {
          "type": "string",
          "description": "Administrative PIN code",
          "maxLength": 20
        },
        "hospitalName": {
          "type": "string",
          "description": "Hospital group or department name",
          "maxLength": 200
        },
        "departmentName": {
          "type": "string",
          "description": "Sub-department or division name",
          "maxLength": 200
        },
        "subtitle": {
          "type": "string",
          "description": "Hospital location or slogan",
          "maxLength": 300
        }
      },
      "required": ["pin", "hospitalName"]
    },
    "RosterStaff": {
      "title": "RosterStaff",
      "description": "Staff member profile and confidential shift pay rates (admin backend only)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique staff identifier",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Staff full name with title",
          "maxLength": 150
        },
        "position": {
          "type": "string",
          "description": "Official job position",
          "maxLength": 150
        },
        "morningRate": {
          "type": "number",
          "description": "Confidential pay rate per morning shift (ช)"
        },
        "afternoonRate": {
          "type": "number",
          "description": "Confidential pay rate per afternoon shift (บ)"
        },
        "order": {
          "type": "number",
          "description": "Display sort order"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether staff appears in new rosters"
        }
      },
      "required": ["id", "name", "position", "morningRate", "afternoonRate", "order", "isActive"]
    },
    "RosterPublicMonth": {
      "title": "RosterPublicMonth",
      "description": "Published monthly shift roster for public portal display (strictly excludes rates and money)",
      "type": "object",
      "properties": {
        "monthKey": {
          "type": "string",
          "description": "Month key in YYYY-MM format",
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "maxLength": 16
        },
        "yearAD": {
          "type": "number",
          "description": "Gregorian year"
        },
        "month": {
          "type": "number",
          "description": "Month number 1-12"
        },
        "title": {
          "type": "string",
          "description": "Roster title",
          "maxLength": 300
        },
        "holidays": {
          "type": "array",
          "description": "List of holiday/weekend day numbers 1-31"
        },
        "rows": {
          "type": "array",
          "description": "Staff shift rows without monetary fields"
        },
        "isPublished": {
          "type": "boolean",
          "description": "Publication visibility flag"
        },
        "note": {
          "type": "string",
          "description": "Optional public remark",
          "maxLength": 1000
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp",
          "maxLength": 64
        }
      },
      "required": ["monthKey", "yearAD", "month", "title", "holidays", "rows", "isPublished", "updatedAt"]
    },
    "RosterAdminMonth": {
      "title": "RosterAdminMonth",
      "description": "Admin backend monthly shift schedule including draft state and confidential pay rates",
      "type": "object",
      "properties": {
        "monthKey": {
          "type": "string",
          "description": "Month key in YYYY-MM format",
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "maxLength": 16
        },
        "yearAD": {
          "type": "number",
          "description": "Gregorian year"
        },
        "month": {
          "type": "number",
          "description": "Month number 1-12"
        },
        "title": {
          "type": "string",
          "description": "Roster title",
          "maxLength": 300
        },
        "holidays": {
          "type": "array",
          "description": "List of holiday/weekend day numbers 1-31"
        },
        "rows": {
          "type": "array",
          "description": "Staff shift rows including confidential pay rates"
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether published to public roster"
        },
        "note": {
          "type": "string",
          "description": "Admin remark",
          "maxLength": 1000
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp",
          "maxLength": 64
        }
      },
      "required": ["monthKey", "yearAD", "month", "title", "holidays", "rows", "isPublished", "updatedAt"]
    },
    "RosterConfig": {
      "title": "RosterConfig",
      "description": "Official roster print header, legend, and signatories configuration",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Config document ID",
          "maxLength": 64
        },
        "departmentTitle": {
          "type": "string",
          "description": "Header title for official schedule",
          "maxLength": 300
        },
        "morningLabel": {
          "type": "string",
          "description": "Morning shift legend",
          "maxLength": 200
        },
        "afternoonLabel": {
          "type": "string",
          "description": "Afternoon shift legend",
          "maxLength": 200
        },
        "leftSignatoryName": {
          "type": "string",
          "description": "Left signatory full name",
          "maxLength": 150
        },
        "leftSignatoryPosition": {
          "type": "string",
          "description": "Left signatory position",
          "maxLength": 150
        },
        "leftSignatoryRole": {
          "type": "string",
          "description": "Left signatory role",
          "maxLength": 200
        },
        "rightSignatoryName": {
          "type": "string",
          "description": "Right signatory full name",
          "maxLength": 150
        },
        "rightSignatoryPosition": {
          "type": "string",
          "description": "Right signatory position",
          "maxLength": 150
        },
        "rightSignatoryRole": {
          "type": "string",
          "description": "Right signatory role",
          "maxLength": 200
        }
      },
      "required": ["id", "departmentTitle", "morningLabel", "afternoonLabel"]
    }
  },
  "firestore": {
    "/apps/{appId}": {
      "schema": "AppItem",
      "description": "Collection of all web applications and tools"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of categories"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Collection of announcements"
    },
    "/settings/{settingId}": {
      "schema": "PortalSettings",
      "description": "Configuration settings document"
    },
    "/roster_staff/{staffId}": {
      "schema": "RosterStaff",
      "description": "Master staff roster list with confidential shift rates"
    },
    "/rosters_public/{monthKey}": {
      "schema": "RosterPublicMonth",
      "description": "Published monthly rosters without monetary data"
    },
    "/rosters_admin/{monthKey}": {
      "schema": "RosterAdminMonth",
      "description": "Admin monthly rosters with draft state and confidential pay rates"
    },
    "/roster_config/{configId}": {
      "schema": "RosterConfig",
      "description": "Official roster print configuration and signatories"
    }
  }
}
